{
  "name": "diskominfo-ciamis/simpati-backend",
  "description": "Backend Laravel Filament untuk SIMPATI Diskominfo Ciamis",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "filament/filament": "^3.2",
    "laravel/sanctum": "^4.0"
  },
  "autoload": { "psr-4": { "App\\": "app/" } },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
